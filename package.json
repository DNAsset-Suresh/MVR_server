    "db:migrate": "node src/db/migrate.js",
    "db:status": "node src/db/status.js"
  },
  "dependencies": {
    "@google-cloud/speech": "^8.2.0",
    "@google-cloud/text-to-speech": "^7.2.0",
    "@google/genai": "^2.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0"
  }
}
