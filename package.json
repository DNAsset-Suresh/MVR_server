{
  "name": "inspireup-server",
  "version": "1.0.0",
  "description": "InspireUp Backend API with Gemini AI and PostgreSQL Booking Engine",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test-concurrency=1 --test",
